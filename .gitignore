# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary and log files
*.log
*.tmp
*.bak

# Ignore large ROM archives, raw images, and unpacked trees
input/*
!input/.gitkeep

images/*
!images/.gitkeep

cauldron/*
!cauldron/.gitkeep

finalized/*
!finalized/.gitkeep

output/*
!output/.gitkeep

# Active project state pointer
project/.active_project

# Project workspaces - ignore raw partitions, images, archives, unpacked directories
project/*/*/*
!project/*/*/.gitkeep
!project/*/.gitkeep
!project/*/project.json
!project/*/cauldron/config/
!project/*/cauldron/config/*

